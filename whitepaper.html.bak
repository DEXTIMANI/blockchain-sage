<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sage Token | Official Whitepaper</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* === CSS STYLES === */
        :root {
            --bg-dark: #050505;
            --card-bg: #111;
            --sage-green: #00FF00;
            --text-main: #e0e0e0;
            --text-dim: #a0a0a0;
            --accent-blue: #2b67e2;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container { display: flex; flex-wrap: wrap; }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #000;
            border-right: 1px solid #222;
            min-height: 100vh;
            padding: 30px 20px;
            position: fixed;
        }

        .logo {
            color: var(--sage-green);
            font-weight: bold;
            font-size: 1.4rem;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        nav ul { list-style: none; padding: 0; text-align: left !important; }
        nav li { margin-bottom: 15px; }
        nav li a {
            color: var(--text-dim);
            text-decoration: none;
            transition: 0.3s;
            font-size: 0.95rem;
        }
        nav li a:hover { color: var(--sage-green); padding-left: 5px; }

        .back-btn {
            display: inline-block;
            margin-top: 50px;
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: bold;
        }

        /* Content */
        .content {
            margin-left: 260px;
            flex: 1;
            padding: 60px 5%;
            max-width: 1000px;
        }

        .section { margin-bottom: 60px; }
        h1 { font-size: 2.5rem; color: #fff; margin-bottom: 10px; }
        h2 { font-size: 1.8rem; border-bottom: 1px solid #222; padding-bottom: 10px; margin-bottom: 20px; }
        .accent { color: var(--sage-green); }

        /* LIST ALIGNMENT FEATURE */
        ul {
            text-align: left;
            padding-left: 20px;
            list-style-position: outside;
        }
        li { text-align: left; margin-bottom: 10px; }

        /* Abstract Box */
        .abstract-box {
            background: rgba(0, 255, 0, 0.03);
            border: 1px solid rgba(0, 255, 0, 0.2);
            padding: 25px;
            border-radius: 12px;
        }

        /* Grid Cards */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
        .card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            border: 1px solid #222;
        }

        /* Tokenomics */
        .tokenomics-container {
            background: #000;
            border: 1px solid var(--sage-green);
            padding: 30px;
            border-radius: 15px;
            text-align: left;
        }
        .bold-green { color: var(--sage-green); font-weight: 900; font-size: 1.3rem; }

        .contract-wrapper {
            background: #111;
            padding: 15px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            border: 1px dashed #444;
        }
        code { font-family: monospace; color: #fff; font-weight: bold; font-size: 0.9rem; word-break: break-all; }

        .copy-btn {
            background: var(--sage-green);
            color: #000;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 10px;
        }

        .bsc-link {
            display: inline-block;
            margin-top: 15px;
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: bold;
        }

        /* Responsive Mobile */
        @media (max-width: 850px) {
            .sidebar { width: 100%; height: auto; position: relative; border-right: none; border-bottom: 1px solid #222; }
            .content { margin-left: 0; padding: 30px 20px; }
            .container { flex-direction: column; }
        }
    </style>
</head>
<body>

    <div class="container">
        <aside class="sidebar">
            <div class="logo">
                <i class="fas fa-leaf"></i> SAGE TOKEN
            </div>
            <nav>
                <ul>
                    <li><a href="#abstract">Abstract</a></li>
                    <li><a href="#origin">1.0 Origin</a></li>
                    <li><a href="#intro">2.0 Introduction</a></li>
                    <li><a href="#solution">3.0 Challenges & Solutions</a></li>
                    <li><a href="#tokenomics">4.0 Tokenomics</a></li>
                    <li><a href="#roadmap">5.0 Roadmap</a></li>
                </ul>
            </nav>
            <a href="index.html" class="back-btn"><i class="fas fa-arrow-left"></i> Back to Main Site</a>
        </aside>

        <main class="content">
            <header class="section">
                <h1>$Sage Token Whitepaper</h1>
                <p style="color: var(--sage-green); font-weight: bold;">The Future of Mobile-First Mining</p>
            </header>

            <article id="abstract" class="section">
                <div class="abstract-box">
                    <h2>Abstract</h2>
                    <p>$Sage is a decentralized community token, first mobile-first mining ecosystem designed to make cryptocurrency accessible to everyone. Using a gamified, tap-to-mine mobile app connected to a secure cloud backend, users can mine the $Sage token without technical knowledge or hardware.</p>
                </div>
            </article>

            <article id="origin" class="section">
                <h2><span class="accent">1.0</span> Origin of Cryptocurrency</h2>
                <p>Cryptocurrency emerged in 2008 with the Bitcoin whitepaper by Satoshi Nakamoto. $Sage builds on this legacy to make blockchain participation easy, removing reliance on centralized banks and expensive hardware.</p>
            </article>

            <article id="intro" class="section">
                <h2><span class="accent">2.0</span> Introduction</h2>
                <p>$Sage token turns smartphones into blockchain portals. Through its cloud-powered mobile mining app, users can earn $Sage tokens without technical skills or expensive equipment.</p>
            </article>

            <article id="solution" class="section">
                <h2><span class="accent">3.0</span> Challenges & Solutions</h2>
                <div class="grid">
                    <div class="card">
                        <h3 class="accent">The Challenges</h3>
                        <ul>
                            <li>Expensive hardware (GPUs/ASICs)</li>
                            <li>Energy waste & environmental impact</li>
                            <li>Requires deep technical knowledge</li>
                        </ul>
                    </div>
                    <div class="card">
                        <h3 class="accent">The $Sage Solution</h3>
                        <ul>
                            <li>Tap-to-Mine: No hardware needed</li>
                            <li>Cloud Mining: Minimal device impact</li>
                            <li>Web3-ready with DAO governance</li>
                        </ul>
                    </div>
                </div>
            </article>

            <article id="tokenomics" class="section">
                <h2><span class="accent">4.0</span> Tokenomics</h2>
                <div class="tokenomics-container">
                    <p><strong>Name:</strong> Blockchain Sage</p>
                    <p><strong>Symbol:</strong> $Sage</p>
                    <p><strong>Total Supply:</strong> <span class="bold-green">950,000,000,000,000</span></p>
                    <p><strong>Chain:</strong> Binance Smart Chain (BEP-20)</p>
                    
                    <div class="contract-wrapper">
                        <code id="contract">0xB0b046e9f0C2cf61883f07273797dDB82E95cb79</code>
                        <button class="copy-btn" onclick="copyContract()">Copy</button>
                    </div>
                    
                    <a href="https://bscscan.com/token/0xB0b046e9f0C2cf61883f07273797dDB82E95cb79" target="_blank" class="bsc-link">
                        <i class="fas fa-search"></i> View on BscScan
                    </a>
                </div>
            </article>

            <article id="roadmap" class="section">
                <h2><span class="accent">5.0</span> Roadmap</h2>
                <ul>
                    <li><strong>Phase 1: Foundation</strong> - Project launch, Android app release, Community building.</li>
                    <li><strong>Phase 2: Growth</strong> - iOS release, KYC verification, DEX/CEX listings.</li>
                    <li><strong>Phase 3: Utility</strong> - Web3 Social Media, In-App Wallet, DAO Governance.</li>
                </ul>
            </article>

            <footer style="margin-top: 100px; padding-top: 20px; border-top: 1px solid #222; font-size: 0.8rem; color: var(--text-dim);">
                © 2026 Blockchain Sage. All rights reserved.
            </footer>
        </main>
    </div>

    <script>
        function copyContract() {
            const contractAddr = document.getElementById("contract").innerText;
            navigator.clipboard.writeText(contractAddr).then(() => {
                const btn = document.querySelector(".copy-btn");
                btn.innerText = "Copied!";
                btn.style.background = "#fff";
                setTimeout(() => {
                    btn.innerText = "Copy";
                    btn.style.background = "#00FF00";
                }, 2000);
            });
        }

        // Smooth Scrolling for nav links
        document.querySelectorAll('.sidebar a').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                if(this.getAttribute('href').startsWith('#')) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body>
</html>

